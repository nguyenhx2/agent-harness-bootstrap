# Shell hooks MUST be LF. A CRLF .sh file fails on Linux/macOS with a cryptic
# "bad interpreter: /usr/bin/env bash^M" - the guardrail then silently never fires.
*.sh            text eol=lf
*.py            text eol=lf

# Every rule names its line ending. The Claude plugin directory refuses to validate a repository
# whose export could differ from its blobs - a bare `text` (checked out per machine) or
# eol=crlf - and fails with "Couldn't validate that repository" and no further detail.
# PowerShell runs LF scripts fine, so the .ps1 hooks are LF too.
*.ps1           text eol=lf
*.md            text eol=lf
*.json          text eol=lf
*.template      text eol=lf
