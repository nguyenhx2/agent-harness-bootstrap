<!-- Source of docs/assets/control-layers.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="control-layers" name="Control layers"
           figure-title="Control layers: what the harness enforces, and what it only asks"
           figure-desc="The four control layers the harness-bootstrap quality gate names, ranked by hardness, with the agent's action passing down through them. Layer 1, the settings.json permissions.deny list, decides what the agent cannot see; it is absolute for what it names but a literal prefix match. Layer 2, PreToolUse hooks that exit 2, decides what it cannot do: protect-secrets, protect-harness, guard-destructive, guard-main-commit, check-commit-msg, protect-adr and guard-agent-spawn block, and guard-agent-scope only advises because the payload names no calling seat. An enforced band that is not one of the four follows: the seat frontmatter, with the tools allowlist, disallowedTools, maxTurns and the spawn caps. Layer 3, the agent-guardrails rule, and layer 4, the review commands, run on the model and are advisory. Below them, the files the enforced layers live in are guarded by protect-harness, which asks the user before an edit and refuses a shell write. A runtime band shows harness-toggle and the committed disabled.json ledger: HARD items, including the orchestrator and the review seats, need the typed phrase disable name, and SOFT items, including every other seat, need an explicit yes. A footnote maps the layers onto the README's five: FORCED, HARD, SCOPED, SOFT and HUMAN.">
    <mxGraphModel dx="1200" dy="1102" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="1102" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c10" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="1102" as="geometry"/></mxCell>
        <mxCell id="c11" value="Control layers: what the harness enforces, and what it only asks" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#0F172A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1140" height="30" as="geometry"/></mxCell>
        <mxCell id="c12" value="The four layers the quality gate names, ranked by hardness. Red and green are decided by the harness, with no model consulted; purple is decided by the model." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1140" height="20" as="geometry"/></mxCell>
        <mxCell id="c13" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="230" height="114" as="geometry"/></mxCell>
        <mxCell id="c14" value="LAYER 1" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="112" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="c15" value="Deny rules" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="140" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c16" value="what it cannot SEE" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="164" width="200" height="17" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="276" y="100" width="894" height="114" as="geometry"/></mxCell>
        <mxCell id="c18" value="settings.json permissions.deny: Read(**/.env), *.pem, *.key, secrets/**, git push --force, rm -rf," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="116" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c19" value="plus the Restricted-data paths you name. A denied action never reaches a tool." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="144" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c20" value="Honest limit: a literal prefix, so a reordered command walks past it. Layer 2 is the gate." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="172" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FECACA;strokeColor=#991B1B;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="238" width="230" height="114" as="geometry"/></mxCell>
        <mxCell id="c22" value="LAYER 2" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="250" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="c23" value="Blocking hooks" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="278" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c24" value="what it cannot DO" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="302" width="200" height="17" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#991B1B;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="276" y="238" width="894" height="114" as="geometry"/></mxCell>
        <mxCell id="c26" value="PreToolUse hooks that exit 2: protect-secrets, protect-harness, guard-destructive, guard-main-commit," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="254" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c27" value="check-commit-msg, protect-adr, guard-agent-spawn. 27 hooks ship; eval 312/312 per hook flavour." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="282" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c28" value="guard-agent-scope only advises: the Edit/Write payload names no calling seat." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="310" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c29" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="376" width="230" height="114" as="geometry"/></mxCell>
        <mxCell id="c30" value="ALSO ENFORCED" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#14532D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="388" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="c31" value="Seat frontmatter" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#14532D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="416" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c32" value="not one of the four" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#14532D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="440" width="200" height="17" as="geometry"/></mxCell>
        <mxCell id="c33" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="276" y="376" width="894" height="114" as="geometry"/></mxCell>
        <mxCell id="c34" value="tools: allowlist decides what a seat can REACH; disallowedTools keeps Edit and Write off every read-only seat." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="392" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c35" value="maxTurns is the circuit breaker on a stuck agent: debugger 30, code-reviewer 25, history-tracker 10." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="420" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c36" value="Spawn caps: depth 2, at most 4 at once. scaffold.py refuses a seat that leaves any of these out." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="448" width="864" height="20" as="geometry"/></mxCell>
