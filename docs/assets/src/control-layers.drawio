        <mxCell id="c41" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="276" y="514" width="894" height="86" as="geometry"/></mxCell>
        <mxCell id="c42" value=".claude/rules/agent-guardrails.md: the behaviour layers 1 and 2 cannot express. Loaded every session," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="530" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c43" value="it holds only if the model complies. So does the agent body; effort: is a throttle, not a rein." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="558" width="864" height="20" as="geometry"/></mxCell>
