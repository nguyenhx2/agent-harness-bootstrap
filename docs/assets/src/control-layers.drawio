        <mxCell id="c76" value="enforced - outside the four" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="299" y="1062" width="225" height="19" as="geometry"/></mxCell>
