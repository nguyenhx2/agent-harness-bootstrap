        <mxCell id="c56" value="GUARDED" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#1E3A8A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="748" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="c57" value="The guards' files" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#1E3A8A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="776" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c58" value="decided by you" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#1E3A8A;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="800" width="200" height="17" as="geometry"/></mxCell>
