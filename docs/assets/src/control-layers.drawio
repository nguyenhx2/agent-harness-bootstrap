        <mxCell id="c38" value="LAYER 3" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#581C87;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="526" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="c39" value="Guardrail rule" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#581C87;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="554" width="200" height="20" as="geometry"/></mxCell>
