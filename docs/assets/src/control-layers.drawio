        <mxCell id="c60" value="The files the enforced layers live in are enforced too. protect-harness asks you before an agent edits" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="752" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c61" value=".claude/settings*.json or .claude/hooks/, and refuses a shell write there; without it a guard is" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="780" width="864" height="20" as="geometry"/></mxCell>
