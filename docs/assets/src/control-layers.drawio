        <mxCell id="c64" value="RUNTIME" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#1E293B;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="876" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="c65" value="Switching off" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#1E293B;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="904" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c66" value="on the record" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#1E293B;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="928" width="200" height="17" as="geometry"/></mxCell>
