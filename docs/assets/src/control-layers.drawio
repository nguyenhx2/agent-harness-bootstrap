        <mxCell id="c68" value="/harness-toggle moves a file to .claude/disabled/&lt;kind&gt;/ and records it in the committed .claude/disabled.json." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="880" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c69" value="HARD, the typed phrase disable &lt;name&gt;: protect-secrets, guard-agent-spawn, protect-harness, security-privacy," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="908" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c70" value="agent-guardrails, /review-changes, and the orchestrator, code-reviewer, security-reviewer, reviewer, spec-guardian seats." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="936" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c71" value="SOFT, an explicit yes: guard-main-commit, check-commit-msg, protect-adr, ai-governance, and every other seat." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="964" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c72" value="Against the README's five layers: layer 1 is FORCED, layer 2 is HARD, the frontmatter is SCOPED, layers 3 and 4 run on the model like SOFT, and the typed phrase is HUMAN." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="1028" width="1140" height="19" as="geometry"/></mxCell>
        <mxCell id="c73" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FECACA;strokeColor=#991B1B;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="1064" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="c74" value="enforced - one of the four" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="1062" width="215" height="19" as="geometry"/></mxCell>
