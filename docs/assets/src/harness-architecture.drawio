        <mxCell id="c50" value="docs/tasks/master-plan.md, the board; docs/tasks/active/TASK-NNN.md, criteria, decisions and a session log;" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="648" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c51" value=".claude/disabled.json, what is off and why; .claude/state/history/, the machine-local run archive." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="676" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c52" value="Enforced by git. Survives compaction, session end and a dead IDE: a fresh agent resumes from here." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="704" width="864" height="20" as="geometry"/></mxCell>
