        <mxCell id="c40" value="volatile, budgeted" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#1E293B;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="568" width="200" height="17" as="geometry"/></mxCell>
        <mxCell id="c41" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="276" y="504" width="894" height="114" as="geometry"/></mxCell>
        <mxCell id="c42" value="Always loaded: CLAUDE.md -&gt; @AGENTS.md, 7 unconditional rules, the agent body and the tool schemas." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="520" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c43" value="On demand: 10 path-scoped rules, loaded on a matching file touch, 75% of the rule content." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="548" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c44" value="Enforced by the context window: billed every turn, lost on compaction." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="576" width="864" height="20" as="geometry"/></mxCell>
