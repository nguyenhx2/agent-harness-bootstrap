        <mxCell id="c66" value="The repository, the branches, the data: what every layer above exists to protect," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="904" width="864" height="20" as="geometry"/></mxCell>
