<!-- Source of docs/assets/harness-architecture.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="harness-architecture" name="Harness architecture"
           figure-title="Harness reference architecture: the model is the only swappable layer"
           figure-desc="The harness drawn bottom-up in seven layers, plus a viewer band. L7 orchestration runs on the model and fields a fitted roster: the long, tests, solo_review, db_engineer and db_seeder flags decide which seats exist. L6 the model slot, drawn dashed: seats declare a tier, and model-tiers.md binds judgment to opus, implementation to sonnet and mechanical to haiku; the tier is swappable, the vendor is not. A red line marks that everything below it is unchanged when the model is swapped. L5 the policy plane: 17 rules, the agent bodies and the data-classification table, advisory. L4 the context plane, volatile: 7 unconditional rules always loaded and 10 path-scoped rules on demand, 75 percent of the rule content. L3 the state plane: the board, the task files, the disabled.json ledger and the run archive, durable in git. L2 the enforcement plane, drawn thickest: deny rules, hooks that exit 2, tool allowlists, maxTurns, spawn caps, protect-harness and the harness-toggle ledger, with the guardrail eval passing 312 of 312 cases per hook flavour and no model consulted. L1 the work: the repository, branches and data. Below, the view: harness-graph.json, which harness-view renders as Flow, Graph, Assess and Master-plan views and scores with no model in the loop.">
    <mxGraphModel dx="1200" dy="1176" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="1176" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c10" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="1176" as="geometry"/></mxCell>
        <mxCell id="c11" value="Harness reference architecture: the model is the only swappable layer" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#0F172A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1140" height="30" as="geometry"/></mxCell>
        <mxCell id="c12" value="Read bottom-up. Each layer names who enforces it. Everything below the red line is unchanged when the model is swapped." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1140" height="20" as="geometry"/></mxCell>
        <mxCell id="c13" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="230" height="114" as="geometry"/></mxCell>
        <mxCell id="c14" value="L7" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#581C87;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="112" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="c15" value="Orchestration" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#581C87;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="140" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c16" value="runs on the model" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#581C87;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="164" width="200" height="17" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="276" y="100" width="894" height="114" as="geometry"/></mxCell>
        <mxCell id="c18" value="orchestrator routes -&gt; spec-guardian locks the contract -&gt; dev implements -&gt; qa-test, if chosen -&gt; review gate -&gt; merge." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="116" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c19" value="The roster is fitted, not fixed: the long, tests, solo_review, db_engineer and db_seeder flags decide which seats exist." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="144" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c20" value="An agent's 'done' is a claim, checked against git and the session log, never taken on trust." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="172" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="228" width="230" height="114" as="geometry"/></mxCell>
        <mxCell id="c22" value="L6" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#4C1D95;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="240" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="c23" value="The model slot" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#4C1D95;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="268" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c24" value="the swappable part" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#4C1D95;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="292" width="200" height="17" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="276" y="228" width="894" height="114" as="geometry"/></mxCell>
        <mxCell id="c26" value="Seats declare a tier and model-tiers.md binds it: judgment -&gt; opus, implementation -&gt; sonnet, mechanical -&gt; haiku." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="244" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c27" value="fable is accepted by model: but no seat binds it. scaffold.py refuses a seat whose model: contradicts its row." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="272" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c28" value="Tier is swappable, vendor is not: another vendor needs an execution adapter, a port and not a config change." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="300" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c29" value="Everything BELOW this line is unchanged when you swap the model" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;fontStyle=1;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="30" y="358" width="1140" height="30" as="geometry"/></mxCell>
