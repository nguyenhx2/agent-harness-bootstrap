        <mxCell id="c72" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="276" y="1000" width="894" height="114" as="geometry"/></mxCell>
        <mxCell id="c73" value=".claude/state/harness-graph.json holds every layer above as nodes in one deterministic file." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="1016" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c74" value="harness-view renders Flow, Graph, Assess and Master-plan views of it and scores it against a published rubric:" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="1044" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c75" value="a plain rules engine, no network, exit 1 on a high finding, so a browser and a CI job cannot disagree." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="1072" width="864" height="20" as="geometry"/></mxCell>
