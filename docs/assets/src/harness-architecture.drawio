        <mxCell id="c35" value=".claude/rules/ (17 rules), the agent bodies, and the data-classification table: Public, Internal, Confidential," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="420" width="864" height="20" as="geometry"/></mxCell>
        <mxCell id="c36" value="Restricted. Enforced by nobody; it shapes behaviour. Classification beats seat tier." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="448" width="864" height="20" as="geometry"/></mxCell>
