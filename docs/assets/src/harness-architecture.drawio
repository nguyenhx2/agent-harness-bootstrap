        <mxCell id="c63" value="The work" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="928" width="200" height="20" as="geometry"/></mxCell>
