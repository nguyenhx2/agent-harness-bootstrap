        <mxCell id="c70" value="harness-view" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#1E3A8A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="1040" width="200" height="20" as="geometry"/></mxCell>
