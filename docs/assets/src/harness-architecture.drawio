        <mxCell id="c60" value="/harness-toggle switches a control off on the record, in disabled.json. eval/guardrail_eval.py: 312/312 per hook flavour." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="832" width="864" height="20" as="geometry"/></mxCell>
