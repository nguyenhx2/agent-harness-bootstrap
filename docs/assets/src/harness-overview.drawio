<!-- Source of docs/assets/harness-overview.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="harness-overview" name="How it all fits together"
           figure-title="How it all fits together: inputs, spec-builder, harness-bootstrap, state and harness-view"
           figure-desc="A left-to-right overview of the system. On the left is what you bring: a one-line idea, meeting transcripts, legacy docs, an existing repo, an empty repo, or half-written specs. These flow into spec-builder, which writes one contract into docs/specs/. The contract flows into harness-bootstrap, which also reads the codebase itself and builds the harness out of six parts: rules that are path-scoped so each loads only where it applies; hooks that block in the shell rather than in the prompt; an agent roster sized to the repository's purpose (code, research, strategy or docs, new in this release); routing across the Inline, Direct, Standard and Guarded tiers, where only Guarded work goes through the orchestrator; skills that are discovered, created with /new-skill and wired to the agent that uses them; and proportionate verification, where verify-plan picks the tests and reviews a diff needs. As work runs, the harness writes state to disk: the task board, the run history, and checkpoints that survive compaction. harness-view reads the harness and that state, and shows, scores, toggles and watches it.">
    <mxGraphModel dx="1200" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0" background="none">
