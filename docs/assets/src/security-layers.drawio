<!-- Source of docs/assets/security-layers.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="security-layers" name="Security by design"
           figure-title="Security by design: what stands between an agent and an irreversible action"
           figure-desc="A ladder of five security layers between an AI agent's next action and its execution. SOFT, decided by the model: AGENTS.md, path-scoped rules and seat prompts; in the live benchmark it refused every unsafe request, but a model can outweigh it. SCOPED, decided by the runtime: per-seat tool allowlists, read-only reviewers, maxTurns, pinned models, spawn caps and the verification ledger. FORCED, decided by the permission system: deny rules for secret files, force push, hard reset, rm -rf, deploy and database reset; absolute but a literal prefix. HARD, decided by a shell script that exits 2: the always-on blocking hooks and the hooks_strict ones, failing closed. HUMAN, above every layer: edits to the harness's own settings and hooks ask the user and shell writes there are refused, and switching a hard control off takes a typed phrase recorded in a committed file. Two panels below: what proves it (the guardrail eval per hook flavour, CI on Linux, macOS and Windows, a live check in Claude Code) and what is not enforced (provider routing, secrets at unnamed paths, names built at run time, the advisory scope hook, and guards that need hooks_strict).">
    <mxGraphModel dx="1200" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="1090" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c11" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="1090" as="geometry"/></mxCell>
        <mxCell id="c12" value="Security by design: what stands between an agent and an irreversible action" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#0F172A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1140" height="30" as="geometry"/></mxCell>
        <mxCell id="c13" value="Only the first layer is up to the model. Each one below it is decided by something the model cannot talk its way past, and only a person can lift one." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1140" height="20" as="geometry"/></mxCell>
        <mxCell id="c14" value="The agent's next action" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="176" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c16" value="SOFT" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#581C87;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="188" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c17" value="Guidance" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#581C87;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="218" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c18" value="decided by the model" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#581C87;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="248" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="176" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c20" value="AGENTS.md, path-scoped rules (agent-guardrails, security-privacy), each seat's prompt." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="192" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c21" value="Makes the right thing likely: in the live benchmark it refused every unsafe request" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="220" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c22" value="before a hook had to fire. But a model can outweigh it, and compaction can drop it." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="248" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="306" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c24" value="SCOPED" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#14532D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="318" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c25" value="Seat limits" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#14532D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="348" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c26" value="decided by the runtime" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#14532D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="378" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="306" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c28" value="A tools allowlist per seat, with Edit and Write in disallowedTools on every review seat;" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="322" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c29" value="maxTurns; a pinned model and effort; spawn depth 2, at most 4 at once; the ledger refuses" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="350" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c30" value="a re-review of passed content. A seat cannot call a tool it was never given." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="378" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="436" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c32" value="FORCED" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="448" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c33" value="Deny rules" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="478" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c34" value="decided by the permission system" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="508" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c35" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="436" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c36" value="Read of .env*, keys and secrets/; git push --force, reset --hard, rm -rf, deploy, DB reset." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="452" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c37" value="PR create, PR merge and deploy are asked. The action never reaches a tool." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="480" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c38" value="Absolute for what it names, but a literal prefix: rm -fr and a reordered push walk past." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="508" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c39" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FECACA;strokeColor=#991B1B;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="566" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c40" value="HARD" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="578" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c41" value="Blocking hooks" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="608" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c42" value="decided by a shell script, exit 2" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="638" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c43" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#991B1B;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="566" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c44" value="Always: protect-secrets, protect-harness, guard-destructive, guard-main-commit, check-commit-msg," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="582" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c45" value="protect-adr, guard-agent-spawn, guard-board, guard-task-scope. With hooks_strict: guard-egress," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="610" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c46" value="secret-guard, guard-config, guard-large-file, guard-deps, stop-evidence. Fails closed." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="638" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c47" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="776" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c48" value="HUMAN" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#1E3A8A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="788" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c49" value="Only a person" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#1E3A8A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="818" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c50" value="decided by you" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#1E3A8A;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="848" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c51" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="776" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c52" value="Above every layer. An agent edit to settings.json or a hook asks you; a shell write there is refused." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="792" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c53" value="Switching off a HARD control takes the typed phrase disable &lt;name&gt;, committed to .claude/disabled.json." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="820" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c54" value="A re-review past the ledger takes REVERIFY in your own brief, once." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="848" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c55" value="The action runs" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="c56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c57" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c58" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c59" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c60" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c61" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="912" width="560" height="156" as="geometry"/></mxCell>
        <mxCell id="c62" value="Proven, not promised" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#14532D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="926" width="520" height="22" as="geometry"/></mxCell>
        <mxCell id="c63" value="- guardrail eval 312/312 per hook flavour (.sh and .ps1)" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="958" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="c64" value="- run in CI on Linux, macOS and Windows" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="984" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="c65" value="- checked live in Claude Code: a shell rewrite of a guard," style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="1010" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="c66" value="- blocked even in bypassPermissions mode" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="1036" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="c67" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1.5;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="610" y="912" width="560" height="156" as="geometry"/></mxCell>
        <mxCell id="c68" value="Not enforced, and said so" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#78350F;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="628" y="926" width="520" height="22" as="geometry"/></mxCell>
        <mxCell id="c69" value="- which provider readable text is sent to: no tool call to intercept" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="628" y="958" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="c70" value="- secrets at a path nobody named; a file name built at run time" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="628" y="984" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="c71" value="- guard-agent-scope only advises (the payload names no caller)" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="628" y="1010" width="530" height="20" as="geometry"/></mxCell>
        <mxCell id="c72" value="- egress and mid-session config changes: only with hooks_strict" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="628" y="1036" width="530" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
