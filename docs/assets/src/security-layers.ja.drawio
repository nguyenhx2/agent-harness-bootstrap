        <mxCell id="c65" value="- Claude Code で実機確認: ガードをシェルで書き換える操作を、" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="1010" width="530" height="20" as="geometry"/></mxCell>
