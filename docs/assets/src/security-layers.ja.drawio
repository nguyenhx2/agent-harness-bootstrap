<!-- Source of docs/assets/security-layers.ja.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="security-layers" name="設計によるセキュリティ"
           figure-title="設計によるセキュリティ: エージェントと取り消せない操作の間にあるもの"
           figure-desc="AI エージェントの次の操作と実行の間にある 5 つのセキュリティ層の図。SOFT はモデルが判定する AGENTS.md、パス限定ルール、席のプロンプト。SCOPED はランタイムが判定する席ごとのツール許可、読み取り専用のレビュアー、maxTurns、固定モデル、生成上限、検証台帳。FORCED は権限システムが判定する拒否ルールで、秘密ファイル、force push、hard reset、rm -rf、デプロイ、DB リセットを止めるが前方一致のみ。HARD はシェルスクリプトが exit 2 で判定する常時と hooks_strict のフックで、失敗時は止める。HUMAN はすべての層の上にあり、ハーネス自身の設定とフックへの編集は確認を求め、シェルからの書き込みは拒否し、HARD の制御を外すには入力した語句がコミットされたファイルに記録される。下の 2 枚は証明 (フック形式ごとのガードレール評価、Linux・macOS・Windows の CI、Claude Code での実機確認) と、強制していないこと。">
    <mxGraphModel dx="1200" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="1090" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c11" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="1090" as="geometry"/></mxCell>
        <mxCell id="c12" value="設計によるセキュリティ: エージェントと取り消せない操作の間にあるもの" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#0F172A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1140" height="30" as="geometry"/></mxCell>
        <mxCell id="c13" value="モデルに任されるのは最初の層だけです。その下の各層は、モデルが言いくるめられないものが判定し、層を外せるのは人だけです。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1140" height="20" as="geometry"/></mxCell>
        <mxCell id="c14" value="エージェントの次の操作" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="176" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c16" value="SOFT" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#581C87;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="188" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c17" value="ガイダンス" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#581C87;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="218" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c18" value="判定: モデル" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#581C87;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="248" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="176" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c20" value="AGENTS.md、パス限定のルール (agent-guardrails、security-privacy)、各席のプロンプト。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="192" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c21" value="正しい行動を起こりやすくする層。実測ベンチマークでは、フックが動く前に危険な依頼を" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="220" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c22" value="すべて拒否した。ただしモデルが上書きすることも、コンパクションで落ちることもある。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="248" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="306" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c24" value="SCOPED" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#14532D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="318" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c25" value="席の制限" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#14532D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="348" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c26" value="判定: ランタイム" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#14532D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="378" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="306" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c28" value="席ごとの tools 許可リスト。レビュー席は Edit と Write を disallowedTools に持つ。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="322" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c29" value="maxTurns、固定のモデルと effort、生成の深さ 2・同時 4 まで、検証台帳は合格済みの再レビューを拒否。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="350" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c30" value="席は与えられていないツールを呼べない。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="378" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="436" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c32" value="FORCED" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="448" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c33" value="拒否ルール" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="478" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c34" value="判定: 権限システム" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="508" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c35" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="436" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c36" value=".env*、鍵、secrets/ の読み取り。git push --force、reset --hard、rm -rf、デプロイ、DB リセット。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="452" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c37" value="PR の作成・マージとデプロイは確認を求める。操作はツールに届かない。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="480" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c38" value="名指ししたものには絶対だが、前方一致のみ: rm -fr や順序を変えた push は通り抜ける。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="508" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c39" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FECACA;strokeColor=#991B1B;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="566" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c40" value="HARD" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="578" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c41" value="ブロックするフック" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#7F1D1D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="608" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c42" value="判定: シェルスクリプト (exit 2)" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="638" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c43" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#991B1B;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="566" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c44" value="常時: protect-secrets、protect-harness、guard-destructive、guard-main-commit、check-commit-msg、" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="582" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c45" value="protect-adr、guard-agent-spawn、guard-board、guard-task-scope。hooks_strict で: guard-egress、" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="610" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c46" value="secret-guard、guard-config、guard-large-file、guard-deps、stop-evidence。失敗時は止める。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="638" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c47" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="776" width="200" height="112" as="geometry"/></mxCell>
        <mxCell id="c48" value="HUMAN" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=20;fontColor=#1E3A8A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="788" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="c49" value="人だけ" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#1E3A8A;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="818" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="c50" value="判定: あなた" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=11;fontColor=#1E3A8A;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="848" width="170" height="18" as="geometry"/></mxCell>
        <mxCell id="c51" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="776" width="920" height="112" as="geometry"/></mxCell>
        <mxCell id="c52" value="すべての層の上にある。settings.json やフックへのエージェントの編集は確認を求め、シェルからの書き込みは拒否。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="792" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c53" value="HARD の制御を外すには disable &lt;name&gt; を自分で入力し、.claude/disabled.json にコミットされる。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="820" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c54" value="検証台帳を越える再レビューは、あなた自身の指示に REVERIFY を書いたときに一度だけ。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="268" y="848" width="890" height="20" as="geometry"/></mxCell>
        <mxCell id="c55" value="操作が実行される" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="c56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c57" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c58" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c59" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c60" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c61" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontSize=14;fontColor=#0F172A;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="912" width="560" height="156" as="geometry"/></mxCell>
        <mxCell id="c62" value="約束ではなく、証明" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#14532D;fontFamily=Helvetica;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="926" width="520" height="22" as="geometry"/></mxCell>
        <mxCell id="c63" value="- ガードレール評価 312/312 (フック形式ごと、.sh と .ps1)" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="958" width="530" height="20" as="geometry"/></mxCell>
