{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"{{#IF_RTK}},
    "RTK_TELEMETRY_DISABLED": "1"{{/IF_RTK}}
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(git worktree list)",
{{#IF_PR_CLI}}      "Bash({{PR_CLI}} list:*)",
      "Bash({{PR_CLI}} view:*)",
      "Bash({{CI_STATUS_CMD}}:*)",
{{/IF_PR_CLI}}      "Bash(python .claude/scripts/:*)",
      "Bash(python3 .claude/scripts/:*)",
{{#IF_TESTS}}      "Bash({{TEST_CMD}}:*)",
{{/IF_TESTS}}      "Bash({{LINT_CMD}}:*)",
      "Bash({{BUILD_CMD}}:*)"
    ],
    "deny": [
      {{RESTRICTED_DENIES}}
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env_*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/credentials.json)",
      "Read(**/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
{{#IF_DB}}      "Bash({{DB_RESET_CMD}}:*)",
{{/IF_DB}}{{^IF_DEPLOY_ASK}}      "Bash({{DEPLOY_CMD}}:*)",
{{/IF_DEPLOY_ASK}}      "Bash(rm -rf:*)"
    ],
    "ask": [
{{#IF_PR_CLI}}      "Bash({{PR_CLI}} create:*)",
      "Bash({{PR_CLI}} merge:*)"{{#IF_DEPLOY_ASK}},{{/IF_DEPLOY_ASK}}
{{/IF_PR_CLI}}{{#IF_DEPLOY_ASK}}      "Bash({{DEPLOY_CMD}}:*)"
{{/IF_DEPLOY_ASK}}    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/protect-adr.{{HOOK_EXT}}",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-agent-scope.{{HOOK_EXT}}",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-task-scope.{{HOOK_EXT}}",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-board.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/protect-secrets.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{#IF_AUDIT}}      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/protect-repos.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_AUDIT}}      {
        "matcher": "Bash",
        "hooks": [
{{#IF_RTK}}          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/rtk-rewrite.{{HOOK_EXT}}",
            "timeout": 10
          },
{{/IF_RTK}}          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-main-commit.{{HOOK_EXT}}",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/check-commit-msg.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-destructive.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{#IF_HOOKS_STRICT}}      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-large-file.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-egress.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{#IF_PURPOSE_CODE}}      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-deps.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_PURPOSE_CODE}}{{/IF_HOOKS_STRICT}}{{#IF_DB}}      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-migration.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_DB}}{{#IF_LONG}}      {
        "matcher": "Bash|PowerShell|Edit|MultiEdit|Write|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/retry-budget.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_LONG}}      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-agent-spawn.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
{{#IF_HOOKS_STRICT}}      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/secret-guard.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_HOOKS_STRICT}}{{#IF_HOOKS_STRICT}}      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-egress.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_HOOKS_STRICT}}{{#IF_PURPOSE_RESEARCH}}      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/research-sources.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_PURPOSE_RESEARCH}}{{#IF_PURPOSE_DOCS}}      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/docs-links.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_PURPOSE_DOCS}}      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/specs-reminder.{{HOOK_EXT}}",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/graph-stale.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
{{#IF_LONG}}    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Edit|MultiEdit|Write|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/retry-budget.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/compact-checkpoint.{{HOOK_EXT}}",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/session-context.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/agent-trace.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/agent-trace.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/agent-trace.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
{{/IF_LONG}}{{#IF_HOOKS_STRICT}}    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/stop-evidence.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/secret-guard.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/guard-config.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      }
    ],
{{/IF_HOOKS_STRICT}}    "SubagentStop": [
{{#IF_HOOKS_STRICT}}      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/stop-evidence.{{HOOK_EXT}}",
            "timeout": 10
          }
        ]
      },
{{/IF_HOOKS_STRICT}}      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_RUNNER}} .claude/hooks/agent-history.{{HOOK_EXT}}",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
