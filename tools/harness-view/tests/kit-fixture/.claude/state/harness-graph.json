    {
      "disabled": false,
      "file": ".claude/agents/orchestrator.md",
      "id": "agent:orchestrator",
      "label": "orchestrator",
      "meta": {
        "description": "2 つ以上の専門領域にまたがる依頼を、タスクボードに登録したタスクへ分解し、専門エージェントへ委譲・検証・進捗管理する指揮役。「実装してレビューして docs まで反映」のように、複数の専門エージェントを順序付きで動かす依頼（Guarded 区分）で使う。1 つの専門エージェントで済む依頼、小さな修正、質問への回答、調査だけの依頼には使わない。",
        "effort": "high",
        "hooks": [
          "PreToolUse Agent -> spawn-guard",
          "PreToolUse Edit|Write|MultiEdit|NotebookEdit -> scope-guard"
        ],
        "maxTurns": 100,
        "model": "opus",
        "permissionMode": "default",
        "spawnAllowlist": [
          "Explore",
          "Plan"
        ],
        "tier": "Guarded",
        "tools": [
          "Agent",
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Write",
          "Edit",
          "AskUserQuestion"
        ]
      },
      "type": "agent"
    },
