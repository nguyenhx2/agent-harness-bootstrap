  "cues": [
    {
      "scene": "open",
      "text": "AIエージェントに、本当に理解できるリポジトリと、",
      "start": 1,
      "end": 5.104,
      "out": 5.72
    },
    {
      "scene": "open",
      "text": "抜け出せないハーネスを。",
      "start": 5.72,
      "end": 7.028,
      "out": 7.828
    },
    {
      "scene": "frame",
      "text": "実務でエージェントを使うチームは、同じことを聞いてきます。",
      "start": 8.967,
      "end": 12.903,
      "out": 13.584
    },
    {
      "scene": "frame",
      "text": "その質問と答えを見ていきましょう。",
      "start": 13.584,
      "end": 15.703,
      "out": 16.503
    },
    {
      "scene": "team",
      "text": "まずはチーム。",
      "start": 17.36,
      "end": 18.267,
      "out": 18.817
    },
    {
      "scene": "team",
      "text": "「自分のプロジェクトに合ったエージェントチームがほしい」",
      "start": 18.817,
      "end": 22.337,
      "out": 22.816
    },
    {
      "scene": "team",
      "text": "harness-bootstrap は、まずコードを読んで、目的を聞きます。",
      "start": 22.816,
      "end": 28.323,
      "out": 29.03
    },
    {
      "scene": "team",
      "text": "開発担当はモジュールごとに一人。全員は入れません。",
      "start": 29.03,
      "end": 33.282,
      "out": 33.863
    },
    {
      "scene": "team",
      "text": "スタックに合うスキルを探して、それぞれを必要な担当につなぎます。",
      "start": 33.863,
      "end": 38.616,
      "out": 39.416
    },
    {
      "scene": "safe",
      "text": "次は、安全とコスト。",
      "start": 40.429,
      "end": 42.214,
      "out": 42.764
    },
    {
      "scene": "safe",
      "text": "「安全にしたい。でも考えすぎやトークンの浪費は困る」",
      "start": 42.764,
      "end": 47.884,
      "out": 48.684
    },
    {
      "scene": "safe",
      "text": "フックはシェルで止めるので、モデルは判定しません。",
      "start": 48.684,
      "end": 52.177,
      "out": 52.735
    },
    {
      "scene": "safe",
      "text": "main への強制プッシュも、最初から拒否。",
      "start": 52.735,
      "end": 55.675,
      "out": 56.176
    },
    {
      "scene": "lean",
      "text": "verify-plan は差分を見て、必要な検証だけを求めます。",
      "start": 56.526,
      "end": 61.634,
      "out": 62.242
    },
    {
      "scene": "lean",
      "text": "合格済みの再レビューは台帳が断り、回数にも上限があります。",
      "start": 62.242,
      "end": 67.55,
      "out": 68.1
    },
    {
      "scene": "lean",
      "text": "モデル、effort、ツールは、エージェントごとに固定。",
      "start": 68.1,
      "end": 72.503,
      "out": 73.303
    },
    {
      "scene": "keys",
      "text": "続いて、秘密情報。",
      "start": 74.404,
      "end": 76.085,
      "out": 76.635
    },
    {
      "scene": "keys",
      "text": "「キーの漏洩が心配」",
      "start": 76.635,
      "end": 78.475,
      "out": 79.275
    },
    {
      "scene": "keys",
      "text": "protect-secrets が、env ファイルや鍵の読み取りを止めます。",
      "start": 79.275,
      "end": 84.064,
      "out": 84.614
    },
    {
      "scene": "keys",
      "text": "env-read は値を使って実行し、出力では伏せます。",
      "start": 84.614,
      "end": 89.324,
      "out": 90.124
    },
    {
      "scene": "loop",
      "text": "次は、仕事の進め方。",
      "start": 91.083,
      "end": 93.194,
      "out": 93.744
    },
    {
      "scene": "loop",
      "text": "「従来の SDLC ではタスクごとに苦労し、AI-DLC は中途半端に終わる」",
      "start": 93.744,
      "end": 101.184,
      "out": 101.984
    },
    {
      "scene": "loop",
      "text": "仕様が判定基準の、一つのループ。要件、タスク、実装、検証、レビュー、完了。",
      "start": 102.063,
      "end": 111.676,
      "out": 112.263
    },
    {
      "scene": "loop",
      "text": "小さな編集はその場で、スキーマ変更はガード付きで。",
      "start": 112.263,
      "end": 116.218,
      "out": 117.018
    },
    {
      "scene": "spec",
      "text": "そして、仕様。",
      "start": 118.258,
      "end": 119.2,
      "out": 119.78
    },
    {
      "scene": "spec",
      "text": "「人が確認でき、AI が理解できる仕様がほしい」",
      "start": 119.78,
      "end": 124.34,
      "out": 125.14
    },
    {
      "scene": "spec",
      "text": "spec-builder は、顧客向けの確認シートと、エージェントが最初に読むインデックスを作ります。",
      "start": 125.14,
      "end": 132.471,
      "out": 133.021
    },
    {
      "scene": "spec",
      "text": "分からないことは、作らずに明示します。",
      "start": 133.021,
      "end": 135.969,
      "out": 136.769
    },
    {
      "scene": "control",
      "text": "次は、中を見ること。",
      "start": 137.74,
      "end": 139.433,
      "out": 139.983
    },
    {
      "scene": "control",
      "text": "「エージェントがどう動いているのか、全体も細部も理解して制御したい」",
      "start": 139.983,
      "end": 146.463,
      "out": 146.937
    },
    {
      "scene": "control",
      "text": "harness-view は、エージェントもルールもフックも、ライブのグラフにします。",
      "start": 146.937,
      "end": 152.519,
      "out": 153.069
    },
    {
      "scene": "control",
      "text": "どの部品も安全にオフにでき、実行はすべて記録されます。",
      "start": 153.069,
      "end": 158.083,
      "out": 158.883
    },
    {
      "scene": "assess",
      "text": "最後は、確認。",
      "start": 159.822,
      "end": 161.191,
      "out": 161.741
    },
    {
      "scene": "assess",
      "text": "「出来上がったハーネスは確認しきれず、直すのも遅い。採点基準も曖昧」",
      "start": 161.741,
      "end": 168.941,
      "out": 169.466
    },
    {
      "scene": "assess",
      "text": "harness-view assess は、それを作業リストに変えます。ワンクリック修正つきです。",
      "start": 169.466,
      "end": 175.793,
      "out": 176.43
    },
    {
      "scene": "assess",
      "text": "指摘には、ルール ID、ファイルと行、直し方。採点表は公開済みです。",
      "start": 176.43,
      "end": 183.691,
      "out": 184.491
    },
    {
      "scene": "close",
      "text": "本当に理解できるリポジトリと、抜け出せないハーネス。",
      "start": 185.386,
      "end": 189.346,
      "out": 190.146
    }
  ],
