  "cues": [
    {
      "scene": "open",
      "text": "AIエージェントに、本当に理解できるリポジトリと、",
      "start": 1,
      "end": 4.68,
      "out": 4.76
    },
    {
      "scene": "open",
      "text": "抜け出せないハーネスを。",
      "start": 4.76,
      "end": 5.966,
      "out": 6.766
    },
    {
      "scene": "frame",
      "text": "実務でエージェントを使うチームは、同じことを聞いてきます。",
      "start": 7.83,
      "end": 11.087,
      "out": 11.64
    },
    {
      "scene": "frame",
      "text": "その質問と答えを見ていきましょう。",
      "start": 11.64,
      "end": 13.764,
      "out": 14.564
    },
    {
      "scene": "team",
      "text": "まずはチーム。",
      "start": 15.414,
      "end": 16.244,
      "out": 16.794
    },
    {
      "scene": "team",
      "text": "「自分のプロジェクトに合ったエージェントチームがほしい」",
      "start": 16.794,
      "end": 19.713,
      "out": 20.263
    },
    {
      "scene": "team",
      "text": "harness-bootstrap は、まずコードを読んで、目的を聞きます。",
      "start": 20.263,
      "end": 24.676,
      "out": 25.338
    },
    {
      "scene": "team",
      "text": "開発担当はモジュールごとに一人。全員は入れません。",
      "start": 25.338,
      "end": 29.538,
      "out": 30.338
    },
    {
      "scene": "safe",
      "text": "次は、安全とコスト。",
      "start": 31.263,
      "end": 32.761,
      "out": 33.311
    },
    {
      "scene": "safe",
      "text": "「安全にしたい。でも考えすぎやトークンの浪費は困る」",
      "start": 33.311,
      "end": 37.448,
      "out": 37.998
    },
    {
      "scene": "safe",
      "text": "フックはシェルで止めるので、モデルは判定しません。",
      "start": 37.998,
      "end": 41.216,
      "out": 41.766
    },
    {
      "scene": "safe",
      "text": "main への強制プッシュも、最初から拒否。",
      "start": 41.766,
      "end": 44.511,
      "out": 45.011
    },
    {
      "scene": "lean",
      "text": "verify-plan は差分を見て、必要な検証だけを求めます。",
      "start": 45.361,
      "end": 49.57,
      "out": 50.264
    },
    {
      "scene": "lean",
      "text": "合格済みの再レビューは台帳が断り、回数にも上限があります。",
      "start": 50.264,
      "end": 54.822,
      "out": 55.372
    },
    {
      "scene": "lean",
      "text": "モデル、effort、ツールは、エージェントごとに固定。",
      "start": 55.372,
      "end": 59.281,
      "out": 60.081
    },
    {
      "scene": "keys",
      "text": "続いて、秘密情報。",
      "start": 61.162,
      "end": 62.606,
      "out": 63.156
    },
    {
      "scene": "keys",
      "text": "「キーの漏洩が心配」",
      "start": 63.156,
      "end": 64.676,
      "out": 64.795
    },
    {
      "scene": "keys",
      "text": "protect-secrets が、env ファイルや鍵の読み取りを止めます。",
      "start": 64.795,
      "end": 69.346,
      "out": 69.896
    },
    {
      "scene": "keys",
      "text": "env-read は値を使って実行し、出力では伏せます。",
      "start": 69.896,
      "end": 74.215,
      "out": 75.015
    },
    {
      "scene": "loop",
      "text": "次は、仕事の進め方。",
      "start": 75.983,
      "end": 77.562,
      "out": 78.112
    },
    {
      "scene": "loop",
      "text": "「従来の SDLC ではタスクごとに苦労し、AI-DLC は中途半端に終わる」",
      "start": 78.112,
      "end": 84.903,
      "out": 85.453
    },
    {
      "scene": "loop",
      "text": "仕様が判定基準の、一つのループ。要件、タスク、実装、検証、レビュー、完了。",
      "start": 85.453,
      "end": 94.413,
      "out": 94.988
    },
    {
      "scene": "loop",
      "text": "小さな編集はその場で、スキーマ変更はガード付きで。",
      "start": 94.988,
      "end": 98.831,
      "out": 99.631
    },
    {
      "scene": "spec",
      "text": "そして、仕様。",
      "start": 100.747,
      "end": 101.601,
      "out": 102.151
    },
    {
      "scene": "spec",
      "text": "「人が確認でき、AI が理解できる仕様がほしい」",
      "start": 102.151,
      "end": 105.774,
      "out": 106.324
    },
    {
      "scene": "spec",
      "text": "spec-builder は、顧客向けの確認シートと、エージェントが最初に読むインデックスを作ります。",
      "start": 106.324,
      "end": 112.632,
      "out": 113.182
    },
    {
      "scene": "spec",
      "text": "分からないことは、作らずに明示します。",
      "start": 113.182,
      "end": 115.761,
      "out": 116.561
    },
    {
      "scene": "control",
      "text": "次は、中を見ること。",
      "start": 117.556,
      "end": 118.992,
      "out": 119.542
    },
    {
      "scene": "control",
      "text": "「エージェントがどう動いているのか、全体も細部も理解して制御したい」",
      "start": 119.542,
      "end": 124.413,
      "out": 124.963
    },
    {
      "scene": "control",
      "text": "harness-view は、エージェントもルールもフックも、ライブのグラフにします。",
      "start": 124.963,
      "end": 129.622,
      "out": 130.172
    },
    {
      "scene": "control",
      "text": "どの部品も安全にオフにでき、実行はすべて記録されます。",
      "start": 130.172,
      "end": 134.391,
      "out": 135.191
    },
    {
      "scene": "assess",
      "text": "最後は、確認。",
      "start": 136.16,
      "end": 137.14,
      "out": 137.69
    },
    {
      "scene": "assess",
      "text": "「出来上がったハーネスは確認しきれず、直すのも遅い。採点基準も曖昧」",
      "start": 137.69,
      "end": 143.45,
      "out": 143.463
    },
    {
      "scene": "assess",
      "text": "harness-view assess は、それを作業リストに変えます。ワンクリック修正つきです。",
      "start": 143.463,
      "end": 150.129,
      "out": 150.679
    },
    {
      "scene": "assess",
      "text": "指摘には、ルール ID、ファイルと行、直し方。採点表は公開済みです。",
      "start": 150.679,
      "end": 157.474,
      "out": 158.274
    },
    {
      "scene": "close",
      "text": "本当に理解できるリポジトリと、抜け出せないハーネス。",
      "start": 159.184,
      "end": 162.904,
      "out": 163.704
    }
  ],
